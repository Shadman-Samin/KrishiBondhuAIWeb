ADVISE_URL=http://127.0.0.1:1234/v1
ADVISE_MODEL=qwen3.5-4b-uncensored-hauhaucs-aggressive
# For 24/7 cloud hosting (Groq free tier — OpenAI-compatible, VERIFIED working):
# ADVISE_URL=https://api.groq.com/openai/v1
# ADVISE_MODEL=openai/gpt-oss-20b
# ADVISE_API_KEY=gsk_your_groq_key_here  (put the real key in host Secrets, never in code)
# ADVISE_HOSTED=auto  # auto | true | false (true = standard OpenAI call, false = LM Studio legacy hacks)
ADVISE_API_KEY=
KRISHI_API_KEY=change_me
# KRISHI_API_KEY is inert (auth removed) but kept secret
OPENWEATHER_API_KEY=your_openweather_api_key
# Real weather for GET /weather/forecast — server fetches from api.openweathermap.org, app just calls /weather/forecast?district=
# 24/7 hosting knobs (HF Spaces / Render / Railway):
# CORS_ORIGINS=https://your-frontend.vercel.app
# APP_SERVER_URL=http://127.0.0.1:8001
# WEB_DIST=/app/web-dist
# YOLO_CONF=0.25
# YOLO_IMSZ=640

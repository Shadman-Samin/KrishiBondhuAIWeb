# Backend mode for the web app: space (production) | fastapi (local)
VITE_BACKEND=space
# Gradio Space base URL (used when VITE_BACKEND=space)
VITE_SPACE_URL=https://hodoly163-krishibondhu-demo.hf.space
# OpenWeather key (client key; also set on Vercel)
VITE_OPENWEATHER_API_KEY=your_openweather_key
